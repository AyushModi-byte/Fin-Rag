# Copy to .env (never commit .env). Used by `python main.py`, `docker compose up` and the eval jobs.

# Three Groq API keys from three separate free accounts: each has its own daily quota, and the LLM client rotates
# between them. One key works, with a third of the daily budget.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Browser origins allowed to call the API, comma separated, no trailing slash. Needed when the web UI is hosted
# elsewhere (for example the Vercel site). Leave empty if nothing calls the API from a browser.
FINRAG_CORS_ORIGINS=

# Optional owner key. A request with a matching X-API-Key header skips the per-IP rate limit (it still counts
# toward the daily cap). With `api.require_api_key: true` in config.yaml the API answers only callers with the key.
FINRAG_API_KEY=

# Optional salt for the hashed client label in the logs. A random one is generated per process if unset.
FINRAG_LOG_SALT=
